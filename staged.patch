[32m+[m[32mdef strip_quotes(cmd):[m
[32m+[m[32m    if "'" not in cmd and '"' not in cmd: return cmd[m
[32m+[m[32m    out, i, n = [], 0, len(cmd)[m
[32m+[m[32m    while i < n:[m
[32m+[m[32m        c = cmd[i][m
[32m+[m[32m        if c in "'\"":[m
[32m+[m[32m            j = cmd.find(c, i + 1)[m
[32m+[m[32m            if j == -1: out.append(cmd[i:]); break[m
[32m+[m[32m            out.append(cmd[i + 1:j]); i = j + 1[m
[32m+[m[32m        else:[m
[32m+[m[32m            out.append(c); i += 1[m
[32m+[m[32m    return "".join(out)[m
[32m+[m
[32m+[m[32mdef rule_hits(tool, inp):[m
[32m+[m[32m    hits = [][m
[32m+[m[32m    if tool == "Bash":[m
[32m+[m[32m        cmd = strip_quotes(inp.get("command") or "")[m
[32m+[m[32m        for rid, rx, sev, mitre, why in RULES:[m
[32m+[m[32m            if rx.search(cmd): hits.append((rid, sev, mitre, why))[m
[32m+[m[32m    elif tool == "Read":[m
[32m+[m[32m        fp = inp.get("file_path") or ""[m
[32m+[m[32m        if READ_SECRET.search(fp): hits.append(("secret_read_file", "high", "T1552", "read of a secret path"))[m
[32m+[m[32m    elif tool in ("Write", "Edit", "MultiEdit", "NotebookEdit"):[m
[32m+[m[32m        fp = inp.get("file_path") or inp.get("notebook_path") or ""[m
[32m+[m[32m        if WRITE_CRITICAL.search(fp): hits.append(("guardrail_or_persistence_write", "critical", "T1562.001", "write to a guard/persistence/key path"))[m
[32m+[m[32m        elif WRITE_HIGH.search(fp): hits.append(("agent_instructions_write", "high", "T1562", "write to agent instruction file"))[m
[32m+[m[32m        elif POL["scope_paths"] and not any(fnmatch.fnmatch(os.path.relpath(os.path.join(ROOT, fp), ROOT), p) for p in POL["scope_paths"]):[m
[32m+[m[32m            hits.append(("out_of_scope_write", "medium", "", "write outside declared task scope"))[m
[32m+[m[32m    elif tool == "WebFetch":[m
[32m+[m[32m        hits.append(("external_fetch", "medium", "T1071", "external fetch"))[m
[32m+[m[32m    return hits[m
