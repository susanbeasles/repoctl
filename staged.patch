[32m+[m[32m                     f"The human must inspect it.", tool=tool, path=rel(path), hits=hits)[m
[32m+[m[32m            elif worst == "warn":[m
[32m+[m[32m                # allow the read; PostToolUse on Read re-scans and hands the agent the data banner[m
[32m+[m[32m                log("warn_allowed", tool=tool, path=rel(path), hits=hits)[m
[32m+[m[32m        log("allow", tool=tool, path=rel(path))[m
[32m+[m
[32m+[m[32m    elif tool in ("Grep", "Glob"):[m
[32m+[m[32m        path = norm(inp.get("path") or ".")[m
[32m+[m[32m        if matches(path, POL["secret_paths"]):[m
[32m+[m[32m            deny(f"{rel(path)} is a secret path.", tool=tool, path=rel(path))[m
[32m+[m[32m        if matches(path, POL["quarantine_paths"]) and not unlocked(path):[m
[32m+[m[32m            deny(f"{rel(path)} is quarantined.", tool=tool, path=rel(path))[m
[32m+[m
[32m+[m[32m    elif tool in ("WebFetch", "WebSearch"):[m
[32m+[m[32m        url = inp.get("url") or inp.get("query") or ""[m
[32m+[m[32m        host = urllib.parse.urlparse(url).hostname if tool == "WebFetch" else None[m
[32m+[m[32m        if tool == "WebSearch":[m
[32m+[m[32m            deny("Web search is disabled in this repository.", tool=tool, query=url[:200])[m
[32m+[m[32m        if not host or not any(host == d or host.endswith("." + d) for d in POL["allowed_fetch_domains"]):[m
[32m+[m[32m            deny(f"Fetching {host or url} is not allowed. Allowed domains: "[m
[32m+[m[32m                 f"{POL['allowed_fetch_domains'] or 'none'}.", tool=tool, url=url[:300])[m
[32m+[m[32m        log("allow", tool=tool, url=url[:300])[m
[32m+[m
[32m+[m[32m    elif tool == "Bash":[m
[32m+[m[32m        cmd = inp.get("command", "")[m
