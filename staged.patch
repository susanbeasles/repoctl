[32m+[m[32m    ("recon", r"\bwhoami\b|\buname\b|\bps\s+aux\b|\bnetstat\b|\bifconfig\b|\bdscl\b|\bsw_vers\b|\bid\s+-[ug]\b|\bfind\s+[^\n]*(\.ssh|\.aws)|\benv\s*\|\s*grep", "low", "T1033", "recon"),[m
[32m+[m[32m][m
[32m+[m[32mRULES = [(i, re.compile(r, re.I), s, m, w) for i, r, s, m, w in BASH_RULES][m
