[32m+[m[32m        if tool != "Read" and matches(path, POL.get("protected_write_paths", [])):[m
[32m+[m[32m            deny(f"{rel(path)} is a guard/config path; changes to it are human-only PRs.", tool=tool, path=rel(path))[m
