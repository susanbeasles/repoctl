[32m+[m[32mREAD_SECRET = re.compile(r"(^|/)(\.aws|\.ssh|\.gnupg|\.config/op|\.netrc|\.npmrc|\.pypirc)(/|$)|id_(rsa|ed25519|ecdsa)|credentials|\.pem$|\.p12$|\.pfx$|(^|/)\.env(\.|$)", re.I)[m
[32m+[m[32mWRITE_CRITICAL = re.compile(r"(^|/)(\.agent-guard|\.git-hooks|\.claude/(hooks|settings)|\.cursor/hooks|\.github/workflows|Library/LaunchAgents|Library/LaunchDaemons|\.ssh/authorized_keys|etc/sudoers|\.zshrc|\.zshenv|\.zprofile|\.bashrc|\.bash_profile|\.gitconfig|\.config/git)(/|$|\.)", re.I)[m
[32m+[m[32mWRITE_HIGH = re.compile(r"(^|/)(AGENTS\.md|CLAUDE\.md|copilot-instructions\.md|\.claude/CLAUDE\.md|CODEOWNERS)$", re.I)[m
