[32m+[m[32m# ----------------------------------------------------------------------------------[m
[32m+[m[32m# Session log[m
[32m+[m[32m# ----------------------------------------------------------------------------------[m
[32m+[m[32mdef sess_path(sid): return os.path.join(SESS_DIR, re.sub(r"[^A-Za-z0-9_.-]", "_", sid) + ".ndjson")[m
[32m+[m
[32m+[m[32mdef load_session(sid, window):[m
[32m+[m[32m    p = sess_path(sid); out = [][m
[32m+[m[32m    if not os.path.exists(p): return out[m
[32m+[m[32m    cutoff = time.time() - window[m
[32m+[m[32m    try:[m
[32m+[m[32m        for line in open(p):[m
[32m+[m[32m            try: e = json.loads(line)[m
[32m+[m[32m            except Exception: continue[m
[32m+[m[32m            if e.get("ts", 0) >= cutoff: out.append(e)[m
[32m+[m[32m    except OSError: pass[m
[32m+[m[32m    return out[m
[32m+[m
[32m+[m[32mdef append_session(sid, e):[m
