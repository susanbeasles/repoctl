[32m+[m[32m        if matches(path, POL["quarantine_paths"]) and not matches(path, POL["quarantine_exempt"]) and not unlocked(path):[m
[32m+[m[32m            deny(f"{rel(path)} is quarantined (untrusted content). Ask the human to run: "[m
