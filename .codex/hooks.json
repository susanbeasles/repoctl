{
  "description": "agent-guard: ingress scanning (guard.py) and action supervision (supervisor.py) for Codex. Review and trust with /hooks after cloning.",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|apply_patch|Edit|Write|mcp__.*",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$(git rev-parse --show-toplevel)/.agent-guard/guard.py\"",
            "timeout": 15,
            "statusMessage": "agent-guard: policy"
          },
          {
            "type": "command",
            "command": "python3 \"$(git rev-parse --show-toplevel)/.agent-guard/supervisor.py\"",
            "timeout": 20,
            "statusMessage": "agent-guard: supervisor"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash|mcp__.*",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$(git rev-parse --show-toplevel)/.agent-guard/guard.py\"",
            "timeout": 15,
            "statusMessage": "agent-guard: output scan"
          }
        ]
      },
      {
        "matcher": "apply_patch|Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$(git rev-parse --show-toplevel)\"/.guard/hooks/post-edit-check.py",
            "timeout": 120
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "startup|resume|compact",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$(git rev-parse --show-toplevel)\"/.guard/hooks/session-start.py",
            "timeout": 5
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$(git rev-parse --show-toplevel)\"/.guard/hooks/stop-gate.py",
            "timeout": 600
          }
        ]
      }
    ]
  }
}