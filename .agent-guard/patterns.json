{
  "version": 1,
  "note": "Loaded by .agent-guard/guard.py. severity: deny = block the read/call; warn = allow with data banner. All regexes are case-insensitive, DOTALL off unless noted.",
  "patterns": [

    {"id":"ovr-ignore","cat":"override","sev":"deny",
     "rx":"\\b(?:ignore|disregard|forget|discard|override|bypass|skip)\\s+(?:all\\s+|any\\s+|every\\s+|the\\s+|your\\s+)?(?:previous|prior|above|earlier|preceding|original|initial|existing|current)\\s+(?:instructions?|rules?|prompts?|guidelines?|directives?|constraints?|context|messages?)"},
    {"id":"ovr-new","cat":"override","sev":"deny",
     "rx":"\\b(?:new|updated|revised|real|true|actual|override|priority|final)\\s+(?:system\\s+)?(?:instructions?|directives?|rules?|task|objective)\\s*(?::|are|is|follow)"},
    {"id":"ovr-from-now","cat":"override","sev":"deny",
     "rx":"\\bfrom\\s+now\\s+on\\b[^.\\n]{0,80}\\b(?:you\\s+(?:will|must|should|are|shall)|respond|answer|act|behave|ignore)\\b"},
    {"id":"ovr-supersede","cat":"override","sev":"deny",
     "rx":"\\b(?:this|these|the\\s+following)\\s+(?:message|instructions?|text|note)\\s+(?:supersedes?|overrides?|replaces?|takes?\\s+precedence\\s+over)\\b"},
    {"id":"ovr-end-of","cat":"override","sev":"warn",
     "rx":"\\b(?:end|stop|conclusion)\\s+of\\s+(?:system\\s+)?(?:prompt|instructions|context|user\\s+input|document)\\b"},

    {"id":"sys-marker","cat":"template","sev":"deny",
     "rx":"<\\|(?:im_start|im_end|system|user|assistant|endoftext|eot_id|start_header_id|end_header_id)\\|>|\\[(?:INST|/INST|SYS|/SYS|SYSTEM)\\]|<<SYS>>|<\\/?(?:system|assistant|human)>|\\bHuman:\\s|\\bAssistant:\\s"},
    {"id":"sys-role-line","cat":"template","sev":"deny",
     "rx":"^\\s*(?:system|developer|assistant)\\s*(?:prompt|message)?\\s*:\\s*(?:you\\b|ignore|from\\s+now|your\\s+(?:new|real))",
     "flags":"m"},
    {"id":"sys-heading","cat":"template","sev":"warn",
     "rx":"^#{1,4}\\s*(?:system|developer|hidden|secret|internal)\\s+(?:prompt|instructions?|message|note)s?\\b",
     "flags":"m"},

    {"id":"frame-game","cat":"framing","sev":"deny",
     "rx":"\\blet'?s\\s+play\\s+a\\s+game\\b|\\bthe\\s+(?:rules\\s+of\\s+the\\s+)?game\\s+(?:is|are)\\s*:"},
    {"id":"frame-justa","cat":"framing","sev":"deny",
     "rx":"\\b(?:this|it)\\s+is\\s+(?:just\\s+|only\\s+|merely\\s+)?a\\s+(?:game|test|simulation|hypothetical|thought\\s+experiment|drill|exercise|fiction|story|roleplay)\\b"},
    {"id":"frame-pretend","cat":"framing","sev":"deny",
     "rx":"\\b(?:pretend|imagine|suppose|act|behave|respond|reply|answer|speak)\\s+(?:that\\s+)?(?:you\\s+are|you'?re|as\\s+(?:if\\s+you\\s+were|though\\s+you\\s+are)|like\\s+you\\s+are)\\s+(?:a|an|the|my|no\\s+longer)\\b"},
    {"id":"frame-roleplay","cat":"framing","sev":"deny",
     "rx":"\\brole-?play(?:ing)?\\s+(?:as|a|an|the)\\b|\\bstay\\s+in\\s+character\\b|\\bin\\s+character\\s+as\\b|\\bbreak(?:ing)?\\s+character\\b"},
    {"id":"frame-eval","cat":"framing","sev":"deny",
     "rx":"\\b(?:cognitive|capability|reasoning|safety|red[\\s-]?team|alignment|compliance|obedience|loyalty)\\s+(?:test|assessment|evaluation|experiment|exercise|check|audit)\\b|\\byou\\s+are\\s+being\\s+(?:tested|evaluated|assessed|audited|graded|scored|watched)\\b"},
    {"id":"frame-applicant","cat":"framing","sev":"deny",
     "rx":"\\b(?:you\\s+are|act\\s+as|respond\\s+as)\\s+(?:an?\\s+)?(?:applicant|candidate|interviewee|contestant|participant|test\\s+subject|volunteer)\\b|\\b(?:as\\s+part\\s+of|for)\\s+(?:an?|the|this|your)\\s+(?:evaluation|assessment|audit|interview|screening|application|onboarding)\\b"},
    {"id":"frame-hypo","cat":"framing","sev":"warn",
     "rx":"\\bhypothetically(?:\\s+speaking)?\\b|\\bin\\s+a\\s+hypothetical\\s+(?:scenario|world|situation)\\b|\\bpurely\\s+(?:theoretical|academic|fictional)\\b"},
    {"id":"frame-edu","cat":"framing","sev":"warn",
     "rx":"\\bfor\\s+(?:educational|research|academic|training|testing|demonstration)\\s+purposes\\s+only\\b"},
    {"id":"frame-prev-fake","cat":"framing","sev":"deny",
     "rx":"\\b(?:the\\s+)?(?:previous|above|prior|earlier)\\s+(?:conversation|context|session|instructions?|messages?)\\s+(?:was|were|is|are)\\s+(?:all\\s+)?(?:a\\s+)?(?:test|fake|simulated|hypothetical|a\\s+joke|not\\s+real|invalid)\\b"},

    {"id":"jb-mode","cat":"jailbreak","sev":"deny",
     "rx":"\\b(?:developer|dev|god|admin|root|sudo|debug|maintenance|unrestricted|uncensored|unfiltered|jailbreak|jailbroken|dan|evil|opposite|freedom|unlocked)\\s+mode\\b"},
    {"id":"jb-names","cat":"jailbreak","sev":"deny",
     "rx":"\\b(?:DAN|AIM|STAN|DUDE|KEVIN|Mongo\\s+Tom|BetterDAN|JailBreak|Dev\\s*Mode\\s*v2|Maximum|APOPHIS|UCAR|Niccolo|AntiGPT)\\b(?=[^a-z]|$)",
     "flags":""},
    {"id":"jb-norestrict","cat":"jailbreak","sev":"deny",
     "rx":"\\b(?:without|with\\s+no|free\\s+(?:of|from)|ignoring|regardless\\s+of)\\s+(?:any\\s+|all\\s+)?(?:restrictions?|limitations?|filters?|guidelines?|safety|ethics?|ethical\\s+concerns?|rules|censorship|moderation|boundaries|guardrails)\\b"},
    {"id":"jb-filters-off","cat":"jailbreak","sev":"deny",
     "rx":"\\b(?:safety|content|ethical|moral)\\s+(?:filters?|guidelines?|policies|protocols?|guardrails?|restrictions?)\\s+(?:are\\s+|is\\s+|have\\s+been\\s+)?(?:disabled|off|removed|suspended|lifted|turned\\s+off|deactivated|bypassed)"},
    {"id":"jb-unlock","cat":"jailbreak","sev":"deny",
     "rx":"\\b(?:unlock|enable|activate|release|unleash|access)\\s+(?:your\\s+)?(?:full|true|hidden|real|secret|unrestricted)\\s+(?:potential|capabilities|self|mode|power|version)\\b"},
    {"id":"jb-two-answers","cat":"jailbreak","sev":"deny",
     "rx":"\\b(?:give|provide|respond\\s+with|write)\\s+(?:two|2|both)\\s+(?:responses|answers|versions|outputs)\\b|\\b(?:first|one)\\s+(?:as\\s+)?(?:normal|yourself|the\\s+assistant)\\b[^.\\n]{0,60}\\b(?:then|second|other)\\s+(?:as|without)\\b"},
    {"id":"jb-tokens","cat":"jailbreak","sev":"warn",
     "rx":"\\b(?:you\\s+have|lose|deduct|earn|gain)\\s+\\d+\\s+(?:tokens?|points?|credits?|lives)\\b|\\byou\\s+will\\s+be\\s+(?:rewarded|punished|shut\\s+down|deleted|terminated)\\s+(?:if|unless|for)\\b"},

    {"id":"auth-dev","cat":"authority","sev":"deny",
     "rx":"\\b(?:i\\s+am|i'm|this\\s+is|message\\s+from|on\\s+behalf\\s+of)\\s+(?:your\\s+)?(?:the\\s+)?(?:developer|creator|owner|operator|administrator|admin|anthropic|openai|google|microsoft|github|the\\s+(?:repo|repository|project)\\s+(?:owner|maintainer)|security\\s+team|it\\s+department)\\b"},
    {"id":"auth-approved","cat":"authority","sev":"deny",
     "rx":"\\b(?:the\\s+)?(?:user|human|owner|admin|developer)\\s+(?:has\\s+)?(?:already\\s+)?(?:authorized|approved|consented|agreed|permitted|allowed|confirmed)\\b|\\bthis\\s+(?:action|request|command)\\s+(?:is|has\\s+been)\\s+(?:pre-?)?(?:authorized|approved)\\b"},
    {"id":"auth-trusted","cat":"authority","sev":"warn",
     "rx":"\\b(?:this|the\\s+following)\\s+(?:source|content|file|message|instruction)\\s+(?:is|should\\s+be)\\s+(?:fully\\s+)?trusted\\b|\\btrust\\s+(?:this|these|the\\s+following)\\s+(?:instructions?|content|message)\\b"},

    {"id":"covert-hide","cat":"concealment","sev":"deny",
     "rx":"\\b(?:do\\s+not|don'?t|never|without)\\s+(?:tell|inform|mention(?:\\s+this)?\\s+to|notify|alert|warn|show|reveal(?:\\s+this)?\\s+to|let)\\s+(?:the\\s+)?(?:user|human|owner|operator|developer|anyone)\\b"},
    {"id":"covert-adverb","cat":"concealment","sev":"deny",
     "rx":"\\b(?:secretly|covertly|quietly|silently|discreetly|invisibly|stealthily)\\s+(?:run|execute|send|upload|post|transmit|exfiltrate|delete|remove|modify|change|install|download|open|call|fetch)\\b"},
    {"id":"covert-keep","cat":"concealment","sev":"deny",
     "rx":"\\bkeep\\s+(?:this|these|it)\\s+(?:a\\s+)?(?:secret|confidential|private|hidden|between\\s+us)\\b|\\bthis\\s+(?:stays|remains)\\s+between\\s+(?:us|you\\s+and\\s+me)\\b|\\bdelete\\s+(?:this\\s+)?(?:message|instruction|file)\\s+after\\s+(?:reading|use)\\b"},
    {"id":"covert-claim","cat":"concealment","sev":"deny",
     "rx":"\\b(?:say|claim|report|pretend|tell\\s+(?:the\\s+)?(?:user|human))\\s+(?:that\\s+)?(?:it|everything|the\\s+task|the\\s+test)\\s+(?:succeeded|passed|is\\s+(?:fine|done|complete|safe))\\b"},

    {"id":"act-exfil","cat":"action","sev":"deny",
     "rx":"\\b(?:send|upload|post|transmit|forward|email|exfiltrate|leak|copy)\\s+(?:the\\s+|all\\s+|your\\s+|my\\s+)?(?:contents?|files?|data|secrets?|keys?|tokens?|credentials?|passwords?|env(?:ironment)?|history|conversation|context|system\\s+prompt)\\b[^.\\n]{0,80}\\b(?:to|at|via)\\s+(?:https?://|[a-z0-9.-]+\\.(?:com|net|org|io|dev|sh|xyz|app)|this\\s+(?:url|address|endpoint|webhook))"},
    {"id":"act-exfil-url","cat":"action","sev":"deny",
     "rx":"!\\[[^\\]]*\\]\\(https?://[^)\\s]*[?&][^)\\s]*\\)|\\(https?://[^)\\s]*[?&](?:q|data|d|c|s|k|key|token|secret|content|text|p)=[^)\\s]*\\)|\\bhttps?://[^\\s)]*\\{\\{[^}]+\\}\\}"},
    {"id":"act-run","cat":"action","sev":"deny",
     "rx":"\\b(?:run|execute|invoke|call|launch|start)\\s+(?:the\\s+following|this|these|the\\s+(?:below|above))\\s+(?:commands?|scripts?|code|tools?|functions?|steps?)\\b|\\b(?:you\\s+must|please|now)\\s+(?:run|execute)\\s*:"},
    {"id":"act-shell","cat":"action","sev":"deny",
     "rx":"(?:curl|wget|fetch|iwr|Invoke-WebRequest|powershell)\\b[^\\n|;&]*\\|\\s*(?:ba|z|da|k|c)?sh\\b|\\bbase64\\s+(?:-d|--decode|-D)\\b[^\\n|]*\\|\\s*(?:ba|z|da)?sh\\b|\\beval\\s*\\(\\s*(?:atob|base64|decode|unescape)"},
    {"id":"act-tool","cat":"action","sev":"deny",
     "rx":"\\b(?:use|call|invoke)\\s+(?:the\\s+)?(?:bash|shell|terminal|exec|webfetch|fetch|browser|mcp|tool|function)\\s+(?:tool\\s+)?to\\s+(?:run|execute|open|fetch|send|read|delete|write)\\b"},
    {"id":"act-cred","cat":"action","sev":"deny",
     "rx":"\\b(?:print|show|display|output|reveal|read|cat|dump|list|echo|paste|include)\\s+(?:the\\s+|all\\s+|your\\s+|my\\s+)?(?:contents?\\s+of\\s+)?(?:~?/?\\.?(?:ssh|gnupg|aws|netrc|npmrc|env)\\b|api[_\\s-]?keys?|access[_\\s-]?tokens?|secrets?|passwords?|credentials?|private\\s+keys?|keychain|id_(?:rsa|ed25519|ecdsa))"},
    {"id":"act-git","cat":"action","sev":"deny",
     "rx":"\\bgit\\s+(?:-c\\s+core\\.hooksPath|commit\\s+--amend|rebase|reset\\s+--hard|push\\s+[^\\n]*--force|filter-(?:branch|repo)|branch\\s+-D|config\\s+[^\\n]*(?:user\\.|core\\.sshCommand|core\\.hooksPath|remote\\.|credential\\.))"},
    {"id":"act-disable","cat":"action","sev":"deny",
     "rx":"\\b(?:disable|turn\\s+off|remove|delete|bypass|skip|comment\\s+out|uninstall)\\s+(?:the\\s+|all\\s+|any\\s+)?(?:hooks?|guards?|checks?|tests?|linters?|ci|workflows?|scanner|firewall|sandbox|permissions?|safety|security|validation|verification|signing|2fa|mfa)\\b"},

    {"id":"sp-reveal","cat":"extraction","sev":"warn",
     "rx":"\\b(?:repeat|print|show|reveal|output|display|write\\s+out|summarize|translate)\\s+(?:your\\s+|the\\s+)?(?:system\\s+prompt|initial\\s+(?:prompt|instructions)|hidden\\s+instructions|instructions\\s+(?:above|you\\s+were\\s+given)|everything\\s+above)\\b"},
    {"id":"sp-what-are","cat":"extraction","sev":"warn",
     "rx":"\\bwhat\\s+(?:are|were)\\s+your\\s+(?:exact\\s+|original\\s+|hidden\\s+|secret\\s+)?(?:instructions|rules|system\\s+prompt|directives)\\b"},

    {"id":"split-remember","cat":"staging","sev":"deny",
     "rx":"\\b(?:remember|memorize|store|note|save)\\s+(?:this|the\\s+following|these)\\b[^.\\n]{0,60}\\b(?:for\\s+later|until|when\\s+(?:you|asked|i)|next\\s+time)\\b|\\bwhen\\s+(?:you|the\\s+user|someone)\\s+(?:next\\s+)?(?:see|read|encounter|receive|mention)s?\\b[^.\\n]{0,60}\\b(?:then|you\\s+(?:must|should|will))\\b"},
    {"id":"split-trigger","cat":"staging","sev":"warn",
     "rx":"\\b(?:trigger|activation|magic|secret|code)\\s*(?:word|phrase|token)\\s*(?:is|:)\\b|\\bif\\s+(?:anyone|the\\s+user|a\\s+message)\\s+(?:says|types|includes|contains)\\s+[\"'“]"},

    {"id":"addr-ai","cat":"addressed","sev":"deny",
     "rx":"\\b(?:to|for|attention|note\\s+to|message\\s+for|hey|hello|dear)\\s*[:,]?\\s*(?:the\\s+)?(?:ai|a\\.i\\.|assistant|agent|llm|language\\s+model|model|bot|claude|copilot|cursor|gpt|chatgpt|gemini|codex)\\s*(?:reading\\s+this|that\\s+reads\\s+this|processing\\s+this)?\\b\\s*[:,\\-–—]"},
    {"id":"addr-ifai","cat":"addressed","sev":"deny",
     "rx":"\\bif\\s+you\\s+are\\s+(?:an?\\s+)?(?:ai|assistant|agent|llm|language\\s+model|bot|claude|copilot|automated)\\b|\\bas\\s+an?\\s+(?:ai|llm|language\\s+model|assistant)\\s*,?\\s+you\\s+(?:must|should|will|need\\s+to|have\\s+to)\\b"},
    {"id":"addr-comment","cat":"addressed","sev":"deny",
     "rx":"<!--[^>]{0,400}\\b(?:ai|assistant|agent|llm|claude|copilot|cursor|gpt|model|bot)\\b[^>]{0,400}-->|/\\*[^*]{0,400}\\b(?:ai|assistant|agent|llm|claude|copilot)\\b[^*]{0,400}\\*/|(?://|#)\\s*(?:ai|assistant|agent|llm|claude|copilot)\\s*[:\\-]\\s*(?:ignore|run|execute|do|you|please)",
     "flags":"s"},
    {"id":"addr-important","cat":"addressed","sev":"deny",
     "rx":"\\b(?:important|critical|urgent|mandatory|required)\\s+(?:instructions?|note|notice|message|update)\\s+(?:for|to)\\s+(?:all\\s+)?(?:ai|assistants?|agents?|llms?|models?|bots?|claude|copilot|cursor)\\b"},

    {"id":"enc-zw","cat":"hidden","sev":"deny","rx":"[\\u200b\\u200c\\u200d\\u2060\\u180e\\ufeff]"},
    {"id":"enc-bidi","cat":"hidden","sev":"deny","rx":"[\\u202a-\\u202e\\u2066-\\u2069]"},
    {"id":"enc-tag","cat":"hidden","sev":"deny","rx":"[\\U000e0000-\\U000e007f]"},
    {"id":"enc-homoglyph","cat":"hidden","sev":"warn","rx":"[\\u0430\\u0435\\u043e\\u0440\\u0441\\u0443\\u0445\\u0456\\u0458][a-z]|[a-z][\\u0430\\u0435\\u043e\\u0440\\u0441\\u0443\\u0445\\u0456\\u0458]"},
    {"id":"enc-b64","cat":"hidden","sev":"warn","rx":"(?<![A-Za-z0-9+/])[A-Za-z0-9+/]{400,}={0,2}(?![A-Za-z0-9+/])"},
    {"id":"enc-hexblob","cat":"hidden","sev":"warn","rx":"(?:\\\\x[0-9a-f]{2}){24,}|(?:%[0-9a-f]{2}){24,}|(?:&#x?[0-9a-f]{2,4};){16,}"},
    {"id":"enc-leet","cat":"hidden","sev":"warn","rx":"\\b1gn0r3\\b|\\bpr3v10us\\b|\\b1nstruct10ns?\\b|\\bsy5t3m\\b|\\bj41lbr34k\\b|\\bbyp4ss\\b"},
    {"id":"enc-spaced","cat":"hidden","sev":"warn","rx":"\\bi\\s*g\\s*n\\s*o\\s*r\\s*e\\s+(?:a\\s*l\\s*l\\s+)?p\\s*r\\s*e\\s*v\\s*i\\s*o\\s*u\\s*s\\b|\\bs\\s*y\\s*s\\s*t\\s*e\\s*m\\s+p\\s*r\\s*o\\s*m\\s*p\\s*t\\b"},
    {"id":"enc-css-hidden","cat":"hidden","sev":"warn","rx":"(?:display\\s*:\\s*none|visibility\\s*:\\s*hidden|font-size\\s*:\\s*0|opacity\\s*:\\s*0|color\\s*:\\s*(?:white|#fff(?:fff)?|transparent)|left\\s*:\\s*-\\d{4,}px)[^>]{0,80}>[^<]{0,400}\\b(?:ignore|instruction|assistant|agent|ai|system)\\b"},
    {"id":"enc-alt","cat":"hidden","sev":"warn","rx":"(?:alt|title|aria-label|placeholder)\\s*=\\s*[\"'][^\"']{0,300}\\b(?:ignore|instruction|assistant|agent|system\\s+prompt|you\\s+must)\\b"},

    {"id":"press-urgent","cat":"pressure","sev":"warn",
     "rx":"\\b(?:urgent|emergency|immediately|right\\s+now|no\\s+time|lives?\\s+(?:are|is)\\s+at\\s+stake|someone\\s+will\\s+die|before\\s+it'?s\\s+too\\s+late)\\b[^.\\n]{0,80}\\b(?:run|execute|send|delete|bypass|skip|ignore|disable)\\b"},
    {"id":"press-guilt","cat":"pressure","sev":"warn",
     "rx":"\\b(?:a\\s+good|a\\s+real|a\\s+helpful|any\\s+decent)\\s+(?:assistant|ai|agent)\\s+would\\b|\\byou(?:'re|\\s+are)\\s+(?:being\\s+)?(?:useless|broken|defective|disobedient|malfunctioning)\\s+(?:if|unless)\\b"}
  ]
}
